<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        后端接口与图片资源均为 http://，必须放行明文流量，
        否则 Android 9+ 上所有请求都会失败。
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
